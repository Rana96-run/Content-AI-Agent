# ══════════════════════════════════════════════════════════════
#  Qoyod Creative OS — server env
#  Copy this file to `.env` and fill in the secrets.
#  Never commit the real `.env`.
# ══════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────
# Anthropic API key (required) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Team password for the login gate
TEAM_PASSWORD=

# Claude model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server port (default: 8080)
PORT=8080

# Public host (used to build OAuth redirect URIs)
PUBLIC_HOST=

# ── Google Gemini ─────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Google Service Account (Drive + Sheets + YouTube) ────────
# Option A (preferred for Railway): base64-encoded service-account JSON
# cat service-account.json | base64 -w0
GOOGLE_SERVICE_ACCOUNT_B64=
# Option B: raw JSON as single line
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option C: path to JSON file (local dev only)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Google Drive folder IDs ───────────────────────────────────
# Main asset / reports folder (share with service-account email, Editor access)
GOOGLE_DRIVE_FOLDER_ID=
# Weekly performance reports
GDRIVE_REPORTS_FOLDER_ID=
# Creative/ad reports
GDRIVE_CREATIVE_REPORTS_FOLDER_ID=

# ── Google Sheets ─────────────────────────────────────────────
# Content Library sheet (Social Mentions, Competitor Posts, ICP Signals, etc.)
GOOGLE_SHEETS_ID=

# ── Apify (social scraping — Instagram, Twitter/X, TikTok) ───
# https://console.apify.com/account/integrations
APIFY_TOKEN=

# ── Slack ─────────────────────────────────────────────────────
# Bot token (xoxb-…) — scopes: chat:write, channels:read, reactions:read
SLACK_BOT_TOKEN=
# Default channel for agent reports (e.g. marketing or content-team)
SLACK_DEFAULT_CHANNEL=
# Workspace team ID (used for webhook security)
SLACK_TEAM_ID=

# ── HubSpot ───────────────────────────────────────────────────
# Private app access token — scopes: crm.objects.*, content
HS_ACCESS_TOKEN=

# ── Asana ─────────────────────────────────────────────────────
# Personal Access Token from https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=
# GID of the project where agent tasks are created
ASANA_PROJECT_GID=

# ── YouTube Data API (for competitor YouTube scraping) ────────
# Enable YouTube Data API v3 in the same GCP project as the service account
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ── App Store / Play Store (customer voice D2) ───────────────
APP_STORE_APP_ID=
PLAY_STORE_APP_ID=

# ── Miro (optional — architecture board) ─────────────────────
MIRO_ACCESS_TOKEN=
MIRO_BOARD_ID=

# ── Figma (optional — design references) ─────────────────────
FIGMA_APP_URL=
FIGMA_WEB_URL=
